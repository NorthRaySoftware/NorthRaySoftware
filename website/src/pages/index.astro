---
import Base from '../layouts/Base.astro';
import { loadApps, statusLabel, release, brand } from '../lib/metadata.js';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const apps = loadApps();
const rel = release();
const launcher = rel?.installers.find((i) => i.id === 'launcher');
const b = brand();
---
<Base title="NorthRay Software" description="Desktop software for writing and publishing books." current="">
  <section class="hero night" aria-labelledby="hero-title">
    <p class="kicker">NorthRay Software</p>
    <h1 id="hero-title">Desktop software for writing and publishing books.</h1>
    <p class="lede">{b.developer} makes Windows apps for creative work, starting with NorthRay Writing Studio
      for authors. NorthRay Launcher installs, updates and opens them in one place. They work offline, and none of them needs an account.</p>
    <div class="actions">
      {launcher
        ? <a class="button primary" href={`${base}download/#launcher`}>Download NorthRay Launcher</a>
        : <span class="button disabled">No download yet</span>}
      <a class="button" href={`${base}apps/`}>See the apps</a>
    </div>
    {launcher && <p class="meta">Version {launcher.version} · Windows 10 and 11, 64-bit</p>}
    <div class="hero-shot">
      <img src={`${base}screenshots/launcher.png`} width="1112" height="686"
        alt="NorthRay Launcher's library: a night-sky banner, the latest release notes, and the installed apps with Open and Update buttons." />
    </div>
  </section>

  <ul class="pillars" aria-label="What NorthRay stands for">
    <li><b>Free to use</b>No subscriptions, paywalls or deliberately restricted features. Free software shouldn't mean inferior software.</li>
    <li><b>Your work is yours</b>Local storage, offline use and established file formats, so you're never trapped inside an app.</li>
    <li><b>Honest about progress</b>Unfinished features aren't advertised as complete. Each app says plainly what it can and can't do yet.</li>
  </ul>

  <h2>Applications</h2>
  <ul class="catalogue">
    {apps.map((a) => (
      <li style={`--app: ${a.accent ?? 'var(--accent)'}`}>
        <span class="icon"><img src={`${base}icons/${a.id}.png`} alt="" /></span>
        <div>
          <h3>{a.name} <span class="tag">{statusLabel[a.status]}</span></h3>
          <p>{a.tagline}</p>
        </div>
        <div class="links">
          <a class="button" href={`${base}${a.website?.slug ?? a.id}/`}>Learn more</a>
        </div>
      </li>
    ))}
  </ul>
  <p class="aside small muted">Also in NorthRay Launcher, as an optional download: CJ Philip Community, with apps associated with
    author and broadcaster CJ Philip. <a href={`${base}about/#cj-philip`}>More about CJ Philip</a>.</p>
</Base>
