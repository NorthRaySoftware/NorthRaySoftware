#include <windows.h>
#include "resource.h"

IDI_APP ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/northray-browser.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @NRB_VERSION_COMMAS@
PRODUCTVERSION @NRB_VERSION_COMMAS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904b0"
    BEGIN
      VALUE "CompanyName", "@CJ_DEVELOPER@"
      VALUE "LegalCopyright", "@CJ_DEVELOPER@ project"
      VALUE "FileDescription", "NorthRay Browser"
      VALUE "FileVersion", "@NRB_VERSION@"
      VALUE "ProductName", "NorthRay Browser"
      VALUE "ProductVersion", "@NRB_VERSION@"
      VALUE "InternalName", "NorthRayBrowser"
      VALUE "OriginalFilename", "NorthRayBrowser.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1200
  END
END
