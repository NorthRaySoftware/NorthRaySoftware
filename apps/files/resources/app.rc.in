#include <windows.h>
#include "resource.h"

IDI_APP ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/northray-files.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @NRF_VERSION_COMMAS@
PRODUCTVERSION @NRF_VERSION_COMMAS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904b0"
    BEGIN
      VALUE "CompanyName", "@CJ_DEVELOPER@"
      VALUE "LegalCopyright", "@CJ_DEVELOPER@ project"
      VALUE "FileDescription", "NorthRay Files"
      VALUE "FileVersion", "@NRF_VERSION@"
      VALUE "ProductName", "NorthRay Files"
      VALUE "ProductVersion", "@NRF_VERSION@"
      VALUE "InternalName", "NorthRayFiles"
      VALUE "OriginalFilename", "NorthRayFiles.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1200
  END
END
