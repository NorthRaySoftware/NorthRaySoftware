# Builds an installable package folder: copies the app's files, then writes
# package.json listing every file with its size and SHA-256.
#   cmake -DID=cj-radio [-DEXTRA_FILES=a::b] [-DEXTRA_DIRS=c::d] -DVERSION=0.2.0 -DEXE=<path to exe> -DDATA=<metadata dir> -DOUT=<package dir> -P make-package.cmake
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
get_filename_component(EXE_NAME "${EXE}" NAME)
file(COPY "${EXE}" DESTINATION "${OUT}")
if(DATA)
  file(COPY "${DATA}/" DESTINATION "${OUT}/data")
endif()
# Extra files and folders, separated by "::" (folders keep their own name).
if(EXTRA_FILES)
  string(REPLACE "::" ";" EXTRA_FILES "${EXTRA_FILES}")
  file(COPY ${EXTRA_FILES} DESTINATION "${OUT}")
endif()
if(EXTRA_DIRS)
  string(REPLACE "::" ";" EXTRA_DIRS "${EXTRA_DIRS}")
  foreach(D IN LISTS EXTRA_DIRS)
    file(COPY "${D}" DESTINATION "${OUT}")
  endforeach()
endif()
file(GLOB_RECURSE FILES RELATIVE "${OUT}" "${OUT}/*")
list(SORT FILES)
set(ENTRIES "")
foreach(F IN LISTS FILES)
  if(F STREQUAL "package.json")
    continue()
  endif()
  file(SHA256 "${OUT}/${F}" HASH)
  file(SIZE "${OUT}/${F}" SIZE)
  if(ENTRIES)
    string(APPEND ENTRIES ",\n")
  endif()
  string(APPEND ENTRIES "    {\"path\": \"${F}\", \"size\": ${SIZE}, \"sha256\": \"${HASH}\"}")
endforeach()
file(WRITE "${OUT}/package.json" "{\n  \"id\": \"${ID}\",\n  \"version\": \"${VERSION}\",\n  \"executable\": \"${EXE_NAME}\",\n  \"files\": [\n${ENTRIES}\n  ]\n}\n")
